@page "/admin/assign-member-role/{id}"
@using Microsoft.EntityFrameworkCore.Metadata.Internal
@model CS58.Areas.Admin.Pages.User.AddRoleModel
@{
    ViewData["Title"] = "Gán vai trò cho thành viên";
}

<div class="container mt-4">
    <partial name="_StatusMessage" for="StatusMessage" />

    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white py-3">
                    <h5 class="mb-0">
                        <i class="bi bi-person-badge me-2"></i>Gán vai trò cho: <strong>@Model.user.UserName</strong>
                    </h5>
                </div>
                
                <div class="card-body p-4">
                    <form id="set-password-form" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
                        
                        <div class="mb-4">
                            <label asp-for="RoleNames" class="form-label fw-semibold">Phân quyền (Roles)</label>
                            
                            @Html.ListBoxFor(m => m.RoleNames, @Model.allRoles, new { id = "id-select-roles", @class="w-100" })
                            
                            <span asp-validation-for="RoleNames" class="text-danger"></span>

                        </div>

                        <div class="d-flex justify-content-center gap-2 mt-4">
                            <button type="submit" class="btn btn-primary px-4">Cập nhật</button>
                            <a asp-page="./Index" class="btn btn-outline-secondary px-4">Quay lại</a>
                        </div>
                    </form>
                </div>
        <hr>
        <p>Danh sách Claims từ Role: </p>
        @if (Model.ClaimsInRole.Count > 0)
        {
            <ul>
                @foreach (var c in Model.ClaimsInRole)
                {
                    <li>@c.ClaimType : @c.ClaimValue</li>
                }
            </ul>
        }
        <hr>
        <p>Danh sách Claims từ User: </p>
        <a asp-page="./EditUserRoleClaim" asp-page-handler="AddClaim" asp-route-userId="@Model.user.Id">+ Thêm claims</a>
        @if (Model.ClaimsOfUser.Count > 0)
        {
            <ul>
                @foreach (var c in Model.ClaimsOfUser)
                {
                    <li>
                        <a asp-page="./EditUserRoleClaim" asp-page-handler="EditClaim" asp-route-claimId="@c.Id">@c.ClaimType : @c.ClaimValue</a>
                    </li>
                }
            </ul>
        }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/multiple-select@1.7.0/dist/multiple-select.min.css">
    <script src="https://cdn.jsdelivr.net/npm/multiple-select@1.7.0/dist/multiple-select.min.js"></script>
    
    <script>
        // Bọc trong document.ready để đảm bảo HTML tải xong mới gọi plugin
        $(document).ready(function() {
            $('#id-select-roles').multipleSelect({
                selectAll: false,
                keepOpen: false,
                isOpen: false,
                filter: true, 
                width: '100%' 
            });
        });
    </script>
}