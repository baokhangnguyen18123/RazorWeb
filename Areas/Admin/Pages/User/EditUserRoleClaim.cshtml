@page "/admin/edit-user-role-claim/{handler?}"
@model App.Areas.Admin.Pages.User.EditUserRoleClaimModel
@{
    ViewData["Title"] = "Claim user";

}

<partial name="_StatusMessage" model="@Model.StatusMessage" />

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h4 class="card-title mb-0">
                    <i class="bi bi-plus-circle me-2"></i>@ViewData["Title"] '@Model.user.UserName'
                </h4>
            </div>
            <div class="card-body p-4">
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

                    <div class="form-floating mb-3">
                        <input asp-for="Input.ClaimType" class="form-control" placeholder="Nhập tên Claim" aria-required="true"/>
                        <label asp-for="Input.ClaimType" class="form-label"></label>
                        <span asp-validation-for="Input.ClaimType" class="text-danger small"></span>
                    </div>

                    <div class="form-floating mb-3">
                        <input asp-for="Input.ClaimValue" class="form-control" placeholder="Nhập giá trị Claim" aria-required="true"/>
                        <label asp-for="Input.ClaimValue" class="form-label"></label>
                        <span asp-validation-for="Input.ClaimValue" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-center gap-2">
                        @if(Model.UserClaim != null)
                        {
                            <button type="submit" class="btn btn-primary btn">
                                <i class="bi bi-save me-1"></i> Cập nhật
                            </button>
                            <button type="submit" class="btn btn-danger btn" asp-page-handler="DeleteClaim" asp-route-claimId="@Model.UserClaim.Id">
                                <i class="bi bi-trash me-1"></i> Xóa
                            </button>
                        }
                        else
                        {
                            <button type="submit" class="btn btn-primary btn">
                                <i class="bi bi-save me-1"></i> Tạo mới
                            </button>
                        }
                        <a class="btn btn-secondary btn" asp-page="./AddRole" asp-route-id="@Model.user.Id">
                            <i class="bi bi-arrow-left me-1"></i> Quay lại
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

}