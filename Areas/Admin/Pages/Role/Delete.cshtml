@page "/admin/delete-role/{id}"
@model CS58.Areas.Admin.Pages.Role.DeleteModel
@{
    ViewData["Title"] = "Xóa vai trò";
}


<partial name="_StatusMessage" model="@Model.StatusMessage" />

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5 mt-3">
        <div class="card shadow-sm">
            <div class="card-header bg-danger text-white">
                <h4 class="card-title mb-0">
                    <i class="bi bi-plus-circle me-2"></i>@ViewData["Title"]
                </h4>
            </div>
            <div class="card-body p-4">
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

                    <div class="mb-3">
                        <h6>Bạn có chắc chắn muốn xóa vai trò <strong>@Model.Role.Name</strong> không?</h6> 
                    </div>
                    <div class="d-flex justify-content-center gap-2">
                        <button type="submit" class="btn btn-danger btn">
                            <i class="bi bi-trash me-1"></i> Xóa vai trò
                        </button>
                        <a class="btn btn-secondary btn" asp-page="./Index">
                            <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

}